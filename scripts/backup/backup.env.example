# Copy this file outside the repository, for example under
# $HOME/secure-backups/candidate-crm-config/backup.env, and chmod it to 600.
BACKUP_MODE=local
EXPECTED_PROJECT_REF=local
BACKUP_ROOT=/replace/with/a/filevault-protected/backup/directory
SUPABASE_WORKDIR=/replace/with/an/isolated/supabase/workdir
SUPABASE_CLI=/replace/with/the/absolute/path/to/supabase

# Required only when BACKUP_MODE=remote. The password must be percent-encoded.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
